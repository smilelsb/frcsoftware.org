---
/**
 * Renders every entry in the `glossary` content collection, alphabetically.
 *
 * Usage:
 * <GlossaryList />
 * <GlossaryList locale="zh" />
 */

import { getCollection } from 'astro:content';
import { parse } from 'yaml';
import zhGlossary from '../data/zh/glossary.yaml?raw';

interface Props {
    locale?: 'en' | 'zh';
}

interface GlossaryEntry {
    id: string;
    data: {
        definition: string;
        caseSensitive?: boolean | undefined;
    };
}

const { locale = 'en' } = Astro.props;

const terms: GlossaryEntry[] =
    locale === 'zh'
        ? Object.entries(
              parse(zhGlossary) as Record<string, GlossaryEntry['data']>,
          ).map(([id, data]) => ({ id, data }))
        : await getCollection('glossary');

terms.sort((a, b) =>
    a.id
        .toLowerCase()
        .localeCompare(
            b.id.toLowerCase(),
            locale === 'zh' ? 'zh-CN' : undefined,
        ),
);
---

<dl class="glossary-list">
    {
        terms.map(({ id, data }) => (
            <div class="glossary-entry">
                <dt id={id.toLowerCase().replace(/\s+/g, '-')}>{id}</dt>
                <dd>{data.definition}</dd>
            </div>
        ))
    }
</dl>

<style>
    .glossary-list {
        margin: 0;
    }

    .glossary-entry + .glossary-entry {
        margin-top: 1.5rem;
    }

    dt {
        font-weight: 600;
        color: var(--sl-color-white);
    }

    dd {
        margin: 0.25rem 0 0;
    }
</style>
